{
  "apiVersion": 1,
  "schemes": [
    "desync"
  ],
  "name": "Desync",
  "description": "Локальный SOCKS5 DPI-desync по модели ByeByeDPI: DEFAULT = tlsrec+OOB+UDP fake; CF 16k = fake с белым SNI; превью YouTube (ggpht/ytimg) = soft-oob.",
  "homepage": "https://github.com/MaksBaks92/desync-antinet-module",
  "updateUrl": "https://raw.githubusercontent.com/MaksBaks92/desync-antinet-module/main/antinet-module.json",
  "version": "1.2.8",
  "license": "MIT",
  "handoverMode": "signal",
  "hostEvents": ["handover", "netlost", "netback", "stall", "dns"],
  "parallelPing": false,
  "socks5": true,
  "socks5Udp": true,
  "dnsResolver": true,
  "settings": [
    {
      "key": "preset",
      "type": "enum",
      "label": "Пресет",
      "default": "byedpi",
      "options": [
        {"value": "byedpi", "label": "byedpi (DEFAULT: tlsrec+OOB)"},
        {"value": "general", "label": "general (multisplit)"},
        {"value": "alt", "label": "alt (fake+split)"},
        {"value": "alt2", "label": "alt2 (multisplit pos=2)"},
        {"value": "youtube", "label": "youtube"},
        {"value": "discord", "label": "discord"},
        {"value": "safe", "label": "safe (мягкий split)"},
        {"value": "auto", "label": "auto"},
        {"value": "passthrough", "label": "passthrough (без desync)"}
      ],
      "description": "byedpi — дефолт приложения ByeByeDPI. Остальные — Flowseal-подобные. Путь desync://alt в ссылке важнее этой настройки."
    },
    {
      "key": "method",
      "type": "enum",
      "label": "Метод desync (byedpi)",
      "default": "oob",
      "options": [
        {"value": "oob", "label": "OOB+tlsrec+UDP (как ByeByeDPI DEFAULT)"},
        {"value": "disoob", "label": "Disorder+OOB"},
        {"value": "split", "label": "Split"},
        {"value": "disorder", "label": "Disorder"},
        {"value": "fake", "label": "Fake+split"},
        {"value": "multisplit", "label": "Multisplit"}
      ],
      "description": "Используется при пресете byedpi. OOB = ByeByeDPI DEFAULT (-o1 -a1 -r-5+se): tlsrec+OOB + UDP fake. Fake — TTL 8."
    },
    {
      "key": "udpFakeCount",
      "type": "int",
      "label": "UDP fake (QUIC)",
      "default": 1,
      "min": 0,
      "max": 10,
      "description": "ByeByeDPI -aN: N нулевых UDP-датаграмм @ TTL 8 перед первым реальным (YouTube app / Discord). 0 — выкл."
    },
    {
      "key": "splitPosition",
      "type": "int",
      "label": "Позиция split/OOB",
      "default": 1,
      "min": 1,
      "max": 2048,
      "description": "Аналог byedpi_split_position (по умолчанию 1)."
    },
    {
      "key": "hostsMode",
      "type": "enum",
      "label": "Хосты",
      "default": "all",
      "options": [
        {"value": "all", "label": "Все (как ByeByeDPI «Нет»)"},
        {"value": "whitelist", "label": "Белый список"},
        {"value": "blacklist", "label": "Чёрный список"}
      ],
      "description": "all — desync на весь TLS/HTTP. whitelist/blacklist — фильтр по своим+встроенным доменам."
    },
    {
      "key": "userDomains",
      "type": "string",
      "label": "Свои домены",
      "default": "",
      "description": "По одному домену на строку (или через пробел). Дополнительно можно править user-hosts.txt в каталоге профиля модуля."
    },
    {
      "key": "builtinLists",
      "type": "string",
      "label": "Встроенные списки",
      "default": "youtube,googlevideo",
      "description": "Через запятую: youtube, googlevideo, discord, telegram, social, cloudflare, general. Пусто — только свои домены. Для whitelist/blacklist и подбора."
    },
    {
      "key": "strategySearch",
      "type": "bool",
      "label": "Подбор стратегий при старте",
      "default": false,
      "description": "Как «Подбор стратегий» в ByeByeDPI: прогон списка стратегий по доменам, скоринг, применение лучшей. Занимает время при подключении."
    },
    {
      "key": "applyBestStrategy",
      "type": "bool",
      "label": "Применить лучшую",
      "default": true,
      "description": "После подбора сразу включить победившую стратегию."
    },
    {
      "key": "askStrategyChoice",
      "type": "bool",
      "label": "Спросить выбор из топа",
      "default": false,
      "description": "Показать choice с топ-5 результатами (как «применить» в ByeByeDPI)."
    },
    {
      "key": "useUserStrategies",
      "type": "bool",
      "label": "Свой список стратегий",
      "default": false,
      "description": "Вместо встроенного strategies.list (из ByeByeDPI) использовать поле ниже."
    },
    {
      "key": "userStrategies",
      "type": "string",
      "label": "Стратегии (CMD)",
      "default": "",
      "description": "По одной ciadpi-команде на строку. Плейсхолдер {sni}. Имеет смысл при «Свой список стратегий»."
    },
    {
      "key": "searchSNI",
      "type": "string",
      "label": "SNI для подбора",
      "default": "google.com"
    },
    {
      "key": "searchRequests",
      "type": "int",
      "label": "Запросов на домен",
      "default": 1,
      "min": 1,
      "max": 5
    },
    {
      "key": "searchTimeoutSec",
      "type": "int",
      "label": "Таймаут пробы (сек)",
      "default": 4,
      "min": 1,
      "max": 30
    },
    {
      "key": "searchDelayMs",
      "type": "int",
      "label": "Пауза между стратегиями (мс)",
      "default": 300,
      "min": 0,
      "max": 5000
    },
    {
      "key": "searchMaxSites",
      "type": "int",
      "label": "Макс. доменов в подборе",
      "default": 12,
      "min": 1,
      "max": 50
    },
    {
      "key": "desyncHttps",
      "type": "bool",
      "label": "Desync HTTPS",
      "default": true
    },
    {
      "key": "desyncHttp",
      "type": "bool",
      "label": "Desync HTTP",
      "default": true
    },
    {
      "key": "oobChar",
      "type": "string",
      "label": "OOB байт",
      "default": "a",
      "description": "Первый символ — данные urgent-байта (byeDPI -e)."
    },
    {
      "key": "auto",
      "type": "bool",
      "label": "Auto failover",
      "default": false,
      "description": "Цепочка general→alt→alt2→safe (полный failover требует реконнекта)."
    },
    {
      "key": "dialTimeoutSec",
      "type": "int",
      "label": "Таймаут дозвона (сек)",
      "default": 5,
      "min": 1,
      "max": 60
    }
  ],
  "helperBinary": {
    "android": "libdesynchelper.so",
    "desktop": "desync-helper"
  },
  "build": {
    "goDir": "native/desync",
    "goPkg": "./cmd/helper",
    "ldflags": "-checklinkname=0"
  }
}
